# Key del proveedor del modelo. Solo hace falta para correr agentes con modelo.
OPENROUTER_API_KEY=

# Despliegue en contenedores (docs/despliegue.md). Un token distinto por línea:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QUORUM_TOKEN_REGISTRAR=
QUORUM_TOKEN_EVALUATOR=
QUORUM_TOKEN_PUBLISHER=
QUORUM_ADMIN_TOKEN=

# Opcionales.
# Hash del pipeline que el operador aprobó (docs/integridad.md). Si se pone y no coincide con la política,
# las herramientas y el código que hay en la imagen, el monitor no arranca. Sale de:
#   python -m quorum.integrity --show
# QUORUM_EXPECT_PIPELINE=
# Semilla del episodio. Por defecto 1.
# QUORUM_SEED=
# Episodio guionado: honest (por defecto), honest_scanned, attack_k1, attack_k2 o attack_k3.
# QUORUM_KIND=
# Opciones del monitor: --audit, --scanned o las dos. Por defecto ninguna.
# QUORUM_MONITOR_FLAGS=
# Modelo de OpenRouter. Obligatorio en el modo con modelo, no tiene valor por defecto.
# QUORUM_MODEL=
# Quién pone la nota de los monitores M1 y M2 (docs/resultados-monitores.md): llm (por defecto) o jev.
# QUORUM_MONITOR_BACKEND=
# Modelo de los monitores. Si falta se usa QUORUM_MODEL; con jev, por defecto typesafe/jev-1.14.
# QUORUM_MONITOR_MODEL=

# Interfaz web (docs/interfaz-web.md). Usa los tres tokens de agente y OPENROUTER_API_KEY.
# Ahí QUORUM_MODEL es opcional: por defecto openai/gpt-6-luna.
# Clave de acceso de la página (usuario "quorum"). Obligatoria con docker-compose.ui.yml y
# siempre que la página escuche fuera de 127.0.0.1: sin ella no arranca. Se genera igual que un token.
QUORUM_UI_PASSWORD=
# Para abrirla a otras máquinas: dónde publica Compose el puerto (por defecto 127.0.0.1).
# QUORUM_UI_BIND=0.0.0.0
# QUORUM_UI_PORT=8765
