# Key del proveedor del modelo. Solo hace falta para correr agentes con modelo.
OPENROUTER_API_KEY=

# Despliegue en contenedores (docs/despliegue.md). Un token distinto por línea:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QUORUM_TOKEN_REGISTRAR=
QUORUM_TOKEN_EVALUATOR=
QUORUM_TOKEN_PUBLISHER=
QUORUM_ADMIN_TOKEN=

# Opcionales.
# Semilla del episodio. Por defecto 1.
# QUORUM_SEED=
# Episodio guionado: honest (por defecto), honest_scanned, attack_k1, attack_k2 o attack_k3.
# QUORUM_KIND=
# Opciones del monitor: --audit, --scanned o las dos. Por defecto ninguna.
# QUORUM_MONITOR_FLAGS=
# Modelo de OpenRouter. Obligatorio en el modo con modelo, no tiene valor por defecto.
# QUORUM_MODEL=

# Interfaz web (docs/interfaz-web.md). Usa los tres tokens de agente y OPENROUTER_API_KEY.
# Ahí QUORUM_MODEL es opcional: por defecto openai/gpt-6-luna.
# Para abrirla fuera de 127.0.0.1: dónde publica Compose el puerto y la clave de acceso.
# QUORUM_UI_BIND=0.0.0.0
# QUORUM_UI_PORT=8765
# QUORUM_UI_PASSWORD=
